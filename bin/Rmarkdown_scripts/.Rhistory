Save_Tree_Data <- function(df, rootdir, cluster_col) {
for (Group in unique(dplyr::pull(df, {{ cluster_col }}))) {
subdir <- file.path(rootdir, Group)
dir.create(subdir, showWarnings = FALSE, recursive = TRUE)
df_group <- df %>%
dplyr::filter({{ cluster_col }} == Group)
for (src in unique(df_group$Source)) {
Accession <- df_group %>%
dplyr::filter(Source == src) %>%
distinct(AccessionNo, .keep_all = TRUE)
fasta_data <- paste0(">", Accession$SequenceIdHeader, "\n",
Accession$Sequence
)
fasta_file <- file.path(subdir, paste0(Group, "_", src, ".pep"))
writeLines(fasta_data, fasta_file)
message(sprintf("FASTA file saved for: %s %s", Group, src))
distinctAccession <- df_group %>%
distinct(AccessionNo, .keep_all = TRUE) %>%
relocate(SequenceIdHeader)
metadata_file <- file.path(subdir, paste0(Group, "_Metadata", ".csv"))
message(sprintf("Metadata file saved for: %s", Group))
write.csv(distinctAccession,metadata_file, row.names = FALSE,quote = FALSE)
fasta_data2 <- paste0(">", distinctAccession$SequenceIdHeader, "\n",
distinctAccession$Sequence)
fasta_file2 <- file.path(subdir, paste0(Group, "_all",".pep"))
writeLines(fasta_data2, fasta_file2)
}
}
}
