method = "update",
args = list(list(visible = vis)),
label = color_cols[i]
)
})
p <- p %>%
layout(
title = "UMAP projection",
updatemenus = list(
list(
type = "dropdown",
buttons = buttons,
x = 0.1,
y = 1.15
)
)
)
return(p)
}
