make_umap_plot <- function(df, color_col) {
values <- df[[color_col]]
# -----------------------------
# NUMERIC CASE (continuous scale)
# -----------------------------
if (is.numeric(values)) {
fig <- plot_ly(
data = df,
x = ~x,
y = ~y,
type = "scatter",
mode = "markers",
marker = list(
color = values,
colorscale = "Viridis",
showscale = TRUE,
size = 3,
opacity = 0.7
),
text = ~paste0(
"ID: ", identifier,
"<br>", color_col, ": ", values
),
hoverinfo = "text"
)
} else {
# -----------------------------
# CATEGORICAL CASE
# -----------------------------
df[[color_col]] <- as.factor(values)
fig <- plot_ly(
data = df,
x = ~x,
y = ~y,
type = "scatter",
mode = "markers",
color = df[[color_col]],
colors = "Set2",
size = 3,
text = ~paste0(
"ID: ", identifier,
"<br>", color_col, ": ", .data[[color_col]]
),
hoverinfo = "text"
)
}
fig %>% layout(
title = paste("UMAP colored by:", color_col),
plot_bgcolor = "#e5ecf6",
xaxis = list(title = "UMAP 1"),
yaxis = list(title = "UMAP 2")
)
}
