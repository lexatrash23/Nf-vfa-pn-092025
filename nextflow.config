// Manifest 
manifest {
    name = 'Venomflow Analysis'
    author = 'Holford Lab'
    homePage = 'https://github.com/lexatrash23/Nf-vf-pn-092025'
    description = 'Bulk Paired-end RNAseq analysis pipeline for identification of putative venom transcripts.'
    mainScript = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version = '1.0.0'
}

manifest.defaultBranch = 'main'
tower.enabled = true


// CONDA and SINGULARITY // Default Conda
conda.enabled = true
docker.enabled = false
singularity.enabled = false

profiles {
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        wave.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        wave.enabled = true
        conda.enabled = false
        docker.enabled = false
    }
}


// Settings for Holford Lab BRIDGES CLUSTER cpu 1 = ~2GB mem
process {
    executor = 'slurm'
    queue = 'RM-shared'


    //  RSS < 2 GB //All QC, seqkit steps, blastdatabase creation, default for blast Kallisto td2 transdecoder and  but may be need to retry depending on size of files 
    withLabel: 'process_low' {
    cpus = { task.attempt > 1 ? 1.5 * task.attempt : 1 } // 1 3 4.5  
    time = 5.h
    }

    // RSS < 15 GB // Signalp DEEPTMHM Interproscan  BUSCO
    withLabel: 'process_medium' {
        cpus = { task.attempt > 1 ? 5 * task.attempt : 6 } // 6 10 15 
        time = 5.h

    }

    
    // Standard < 25GB //Bowtie
    withLabel: 'process_high' {
        cpus = { task.attempt > 1  ? 10 * task.attempt : 10 } // 10 20 30 
        time = 5.h
 
    }

}
def timestamp = new java.text.SimpleDateFormat("yyyyMMdd-HHmmss").format(new java.util.Date())

report {
    enabled = true
    overwrite = true
    file = "${launchDir}/reports/Analysis/${timestamp}/report.html"

}

timeline {
    enabled = true
    overwrite = true
    file = "${launchDir}/reports/Analysis/${timestamp}/timeline.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${launchDir}/reports/Analysis/${timestamp}/trace.txt"
}

dag {
    enabled = true
    overwrite = true
    file = "${launchDir}/reports/Analysis/${timestamp}/flowchart.html"
}




params {
    input_csv = "${launchDir}/InputFiles/SampleSheet.csv"
    input_interproscan = "${launchDir}/InputFiles/entry.list"
    input_panther = "${launchDir}/InputFiles/Panther_names.csv"
    input_toxin_metadata = "${launchDir}/InputFiles/Toxin_Domains.tsv.gz"
    input_nontoxin_metadata = "${launchDir}/InputFiles/NonToxin_Domains.7z"

    //Fall back Metadata files if the user doesn't provide them 
    Fallback_interproscan = "${projectDir}/MetadataFiles/entry.list"
    Fallback_panther = "${projectDir}/MetadataFiles/Panther_names.csv"
    Fallback_toxin_metadata = "${projectDir}/MetadataFiles/Toxin_Domains.tsv.gz"
    Fallback_nontoxin_metadata = "${projectDir}/MetadataFiles/NonToxin_Domains.7z"
     
    //Fallback blast fastas if the user doesnt provide them 
    toxprot_fasta =  "${launchDir}/InputFiles/ToxProtFasta.fasta"
    Fallback_toxin_fasta = "${projectDir}/MetadataFiles/ToxProtFasta.fasta"
 
    //ProtSpace
    protspace = false
    //default, overriden by command line 

    //Default outputdir is the launchdir
    outdir = "${launchDir}"
}
